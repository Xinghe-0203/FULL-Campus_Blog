# =============================================================================
# 校园博客前端 - 统一环境配置
# =============================================================================
# Vite 会自动加载此文件，开发/生产环境通用
# 如需覆盖，可创建 .env.local（不提交到 git）

# 开发环境专用：Vite 将 /api 和 /uploads 代理至此后端
# 生产环境请在 vercel.json 或反向代理中配置目标地址
VITE_API_TARGET=http://localhost:8825
